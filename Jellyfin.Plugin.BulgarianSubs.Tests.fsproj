<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>false</IsTestProject>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(JELLYFIN_PATH)/MediaBrowser.Model.dll" />
    <Reference Include="$(JELLYFIN_PATH)/MediaBrowser.Controller.dll" />
    <Reference Include="$(JELLYFIN_PATH)/MediaBrowser.Common.dll" />
    <Reference Include="$(JELLYFIN_PATH)/Jellyfin.Data.dll" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="./Jellyfin.Plugin.BulgarianSubs.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="./tests/MetadataExtractorTests.fs" />
    <Compile Include="./tests/DownloadIntegrationTests.fs" />
    <Compile Include="./tests/DownloadSecurityTests.fs" />
    <Compile Include="./tests/JellyfinIntegrationTests.fs" />
    <Compile Include="./tests/FsAutocompleteTests.fs" />
    <Compile Include="./tests/Tests.fs" />
  </ItemGroup>

</Project>
