<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Jellyfin.Plugin.BulgarianSubs</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.BulgarianSubs</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(JELLYFIN_PATH)/MediaBrowser.Model.dll" />
    <Reference Include="$(JELLYFIN_PATH)/MediaBrowser.Controller.dll" />
    <Reference Include="$(JELLYFIN_PATH)/MediaBrowser.Common.dll" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="HtmlAgilityPack" Version="1.11.54" />
    <PackageReference Include="SharpCompress" Version="0.48.1" />
    <PackageReference Include="ZstdSharp.Port" Version="0.7.4" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="./src/ComputationExpressions.fs" />
    <Compile Include="./src/Configuration.fs" />
    <Compile Include="./src/Plugin.fs" />
    <Compile Include="./src/Models.fs" />
    <Compile Include="./src/SubtitleIdentifier.fs" />
    <Compile Include="./src/SubtitleMatching.fs" />
    <Compile Include="./src/Parsing.fs" />
    <Compile Include="./src/MetadataExtractor.fs" />
    <Compile Include="./src/Providers/IProvider.fs" />
    <Compile Include="./src/Providers/Common.fs" />
    <Compile Include="./src/Providers/SabBz.fs" />
    <Compile Include="./src/Providers/Subsunacs.fs" />
    <Compile Include="./src/Providers/YavkaNet.fs" />
    <Compile Include="./src/Providers/Podnapisi.fs" />
    <Compile Include="./src/Providers.fs" />
    <Compile Include="./src/PluginServiceRegistrator.fs" />
  </ItemGroup>

</Project>
